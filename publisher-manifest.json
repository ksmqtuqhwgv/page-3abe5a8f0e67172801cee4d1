        "_brand_page": {
          "version": 3,
          "body": "<style>\n:root{--ink:#0b0c0b;--ink-2:#151715;--ink-3:#1e211e;--line:#2c302c;--green:#c8ff3d;--green-dim:#8fb52b;--text:#e8ebe4;--muted:#9aa196}\n*{box-sizing:border-box}\nhtml,body{margin:0;padding:0}\nbody{background:var(--ink);color:var(--text);font-family:\"Helvetica Neue\",Arial,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;font-size:16px;line-height:1.7;-webkit-font-smoothing:antialiased}\na{color:var(--green);text-decoration:none}\na:hover{text-decoration:underline}\nh1,h2,h3{margin:0;line-height:1.25;font-weight:700;letter-spacing:-0.01em}\np{margin:0}\nul,ol{margin:0;padding-left:1.2em}\nli{margin:0.35em 0}\n.wrap{max-width:1180px;margin:0 auto;padding:0 24px}\n\n/* top bar: breadcrumb + directory */\n.topbar{border-bottom:1px solid var(--line);background:var(--ink-2);position:sticky;top:0;z-index:20}\n.topbar .wrap{display:flex;flex-wrap:wrap;gap:12px 28px;align-items:center;justify-content:space-between;padding-top:12px;padding-bottom:12px}\n.crumb{font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:var(--muted)}\n.crumb b{color:var(--green);font-weight:700}\n.dirnav{display:flex;flex-wrap:wrap;gap:6px 18px;font-size:13px}\n.dirnav a{color:var(--text);padding:4px 0;border-bottom:1px solid transparent}\n.dirnav a:hover{color:var(--green);border-bottom-color:var(--green);text-decoration:none}\n.dirnav a .num{color:var(--green-dim);font-size:11px;margin-right:5px;letter-spacing:0.08em}\n\n/* hero: asymmetric split */\n.hero{padding:64px 0 72px;border-bottom:1px solid var(--line)}\n.hero .wrap{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(0,1fr);gap:56px;align-items:start}\n.eyebrow{display:inline-block;font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:var(--green);border:1px solid var(--green-dim);padding:4px 10px;margin-bottom:26px}\nh1{font-size:clamp(38px,6vw,72px);letter-spacing:-0.03em;margin-bottom:22px}\nh1 .thin{color:var(--muted);font-weight:400}\n.lede{font-size:17px;max-width:52ch;color:#c9cfc3}\n.hero-ask{margin-top:34px;padding-left:18px;border-left:3px solid var(--green);color:var(--text);font-size:16px}\n.hero-ask strong{color:var(--green)}\n\n.panel{border:1px solid var(--line);background:var(--ink-2);padding:26px 24px}\n.panel h2{font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:var(--green);margin-bottom:18px}\n.kv{border-top:1px solid var(--line);padding:11px 0;display:flex;justify-content:space-between;gap:16px;font-size:14px}\n.kv:first-of-type{border-top:0}\n.kv span{color:var(--muted)}\n.kv b{font-weight:600;text-align:right}\n.panel-note{margin-top:16px;font-size:13px;color:var(--muted)}\n\n/* section shell */\nsection.block{padding:76px 0;border-bottom:1px solid var(--line)}\n.sec-head{display:flex;gap:20px;align-items:baseline;flex-wrap:wrap;margin-bottom:14px}\n.sec-tag{font-size:12px;letter-spacing:0.2em;color:var(--green);border:1px solid var(--line);padding:3px 9px;white-space:nowrap}\nh2.sec-title{font-size:clamp(26px,3.4vw,38px)}\n.sec-intro{color:var(--muted);max-width:70ch;margin-bottom:40px}\n\n/* steps: numbered big digits pressed at bottom */\n.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:22px}\n.step{position:relative;background:var(--ink-2);border:1px solid var(--line);padding:26px 24px 34px;overflow:hidden;min-height:230px}\n.step .big{position:absolute;right:8px;bottom:-26px;font-size:104px;font-weight:800;line-height:1;color:var(--ink-3);letter-spacing:-0.05em;pointer-events:none}\n.step h3{font-size:18px;margin-bottom:10px;position:relative}\n.step p{font-size:14px;color:#b9c0b3;position:relative}\n\n/* plans table */\n.table-scroll{overflow-x:auto;border:1px solid var(--line)}\ntable{width:100%;border-collapse:collapse;min-width:720px;font-size:14px}\nthead th{background:var(--ink-3);text-align:left;padding:18px 16px;border-bottom:1px solid var(--line);vertical-align:bottom}\nthead th .plan-name{display:block;font-size:16px;color:var(--text);letter-spacing:-0.01em}\nthead th .plan-price{display:block;font-size:22px;color:var(--green);font-weight:700;margin-top:6px}\nthead th .plan-year{display:block;font-size:12px;color:var(--muted);margin-top:4px}\nthead th.featured{background:#1b2413;border-top:2px solid var(--green)}\n.rec{display:inline-block;font-size:11px;letter-spacing:0.14em;background:var(--green);color:#0b0c0b;padding:2px 8px;font-weight:700;margin-bottom:8px}\ntbody th{text-align:left;padding:14px 16px;color:var(--muted);font-weight:400;border-bottom:1px solid var(--line);width:22%;background:var(--ink-2)}\ntbody td{padding:14px 16px;border-bottom:1px solid var(--line);border-left:1px solid var(--line);color:#cfd5ca;vertical-align:top}\ntbody td.featured{background:#141a10}\ntbody tr:last-child th,tbody tr:last-child td{border-bottom:0}\n.tick{color:var(--green);margin-right:6px}\n.table-note{margin-top:16px;font-size:13px;color:var(--muted);max-width:80ch}\n\n/* clients */\n.clients{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:22px}\n.client{background:var(--ink-2);border:1px solid var(--line);padding:26px 24px 30px;position:relative;overflow:hidden;min-height:200px}\n.client h3{font-size:17px;margin-bottom:8px;position:relative}\n.client .tagline{font-size:13px;color:var(--green);margin-bottom:14px;position:relative}\n.client p{font-size:14px;color:#b9c0b3;position:relative}\n.client .big{position:absolute;right:6px;bottom:-30px;font-size:96px;font-weight:800;line-height:1;color:var(--ink-3);letter-spacing:-0.05em}\n\n/* faq two columns */\n.faq-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 40px}\n.faq{border-top:1px solid var(--line);padding-top:18px}\n.faq h3{font-size:16px;margin-bottom:8px;color:var(--text)}\n.faq h3::before{content:\"—\";color:var(--green);margin-right:8px}\n.faq p{font-size:14px;color:#b9c0b3}\n\n/* closing */\n.closing{padding:70px 0 90px}\n.closing .wrap{display:flex;flex-wrap:wrap;gap:26px;align-items:center;justify-content:space-between}\n.closing h2{font-size:clamp(22px,2.8vw,30px);max-width:24ch}\n.closing .note{font-size:13px;color:var(--muted);max-width:46ch}\nfooter{border-top:1px solid var(--line);background:var(--ink-2)}\nfooter .wrap{display:flex;flex-wrap:wrap;gap:10px 24px;justify-content:space-between;padding-top:22px;padding-bottom:22px;font-size:12px;color:var(--muted)}\nfooter a{color:var(--muted)}\n\n@media (max-width:880px){\n  .hero .wrap{grid-template-columns:1fr;gap:36px}\n  .faq-grid{grid-template-columns:1fr}\n  section.block{padding:56px 0}\n  .hero{padding:48px 0 56px}\n}\n@media (max-width:520px){\n  .topbar .wrap{padding-top:10px;padding-bottom:10px}\n  .step .big{font-size:84px}\n  thead th .plan-price{font-size:19px}\n}\n</style><div class=\"topbar\">\n  <div class=\"wrap\">\n    <div class=\"crumb\">首页 / <b>YY 服务说明</b> / 订阅与使用</div>\n    <nav class=\"dirnav\" aria-label=\"页面目录\">\n      <a href=\"#howto\"><span class=\"num\">01</span>使用步骤</a>\n      <a href=\"#plans\"><span class=\"num\">02</span>订阅方案</a>\n      <a href=\"#clients\"><span class=\"num\">03</span>客户端</a>\n      <a href=\"#faq\"><span class=\"num\">04</span>常见问题</a>\n    </nav>\n  </div>\n</div>\n\n<main>\n\n  <section class=\"hero\">\n    <div class=\"wrap\">\n      <div>\n        <span class=\"eyebrow\">YY / 订阅说明</span>\n        <h1>YY <span class=\"thin\">订阅怎么选，先看这里</span></h1>\n        <p class=\"lede\">这一页不催你下单。它把 YY 的三个订阅档位、每档给出的流量与设备台数、以及开通前需要想清楚的事，按顺序摊开写明白。你可以从第一段读到最后一段，也可以直接跳到想看的那一节。</p>\n        <p class=\"hero-ask\"><strong>你大概会先问：</strong>我该选哪一档？答案取决于你每月的用量和同时在线的设备数量——这两个数字在下面的对比表格里都能直接对上。</p>\n      </div>\n      <aside class=\"panel\" aria-label=\"快速概览\">\n        <h2>一眼概览</h2>\n        <div class=\"kv\"><span>档位数量</span><b>3 档</b></div>\n        <div class=\"kv\"><span>起步价</span><b>¥15 / 月</b></div>\n        <div class=\"kv\"><span>年付起步</span><b>¥150 / 年</b></div>\n        <div class=\"kv\"><span>设备台数区间</span><b>3 — 20 台</b></div>\n        <div class=\"kv\"><span>流量区间</span><b>100GB — 1000GB / 月</b></div>\n        <div class=\"kv\"><span>推荐档位</span><b>旗舰版</b></div>\n        <p class=\"panel-note\">本页所有价格与权益均以正文表格为准；实际开通条件以你确认订阅时的说明为准。</p>\n      </aside>\n    </div>\n  </section>\n\n  <section class=\"block\" id=\"howto\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-tag\">01 使用步骤</span>\n        <h2 class=\"sec-title\">从决定到用上，四步走完</h2>\n      </div>\n      <p class=\"sec-intro\">有人喜欢先看价格，有人习惯先确认自己能不能用。为了不让你在页面里来回翻，这里先把流程讲一遍；每一步后面都附了需要你做的判断。</p>\n\n      <div class=\"steps\">\n        <article class=\"step\">\n          <span class=\"big\">1</span>\n          <h3>先算清自己的用量</h3>\n          <p>把上个月实际消耗的流量和常用设备数量写下来。基础版给 100GB 与 3 台设备，如果你的两个数字都在这条线以内，就不用往上看。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"big\">2</span>\n          <h3>再对照档位选一档</h3>\n          <p>超出基础版，就逐级往上比。旗舰版在流量、设备台数和线路类型上都比基础版多一档；团队版则把台数放宽到 20 台。差多少，表格里一行一行对。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"big\">3</span>\n          <h3>决定月付还是年付</h3>\n          <p>年付价格在三个档位上都低于十二个月月付的合计。如果你打算长期使用，年付更省；如果只是先试一个季度，月付给你留出退出的余地。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"big\">4</span>\n          <h3>选好客户端，按说明配置</h3>\n          <p>YY 在电脑与手机上都提供可用的客户端入口。装好之后按客户端内的引导完成配置即可。设备台数限制按同时在线的终端计算，超出会被挡住。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"block\" id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-tag\">02 订阅方案</span>\n        <h2 class=\"sec-title\">三档横向对比，逐行看差异</h2>\n      </div>\n      <p class=\"sec-intro\">下表把三个档位放在同一行里比，省得你在三张卡片之间来回切。每一行是一项具体权益，价格写在表头，年付价写在月付价下方。</p>\n\n      <div class=\"table-scroll\">\n        <table>\n          <thead>\n            <tr>\n              <th>权益项</th>\n              <th>\n                <span class=\"plan-name\">基础版</span>\n                <span class=\"plan-price\">¥15 / 月</span>\n                <span class=\"plan-year\">年付 ¥150 / 年</span>\n              </th>\n              <th class=\"featured\">\n                <span class=\"rec\">推荐</span>\n                <span class=\"plan-name\">旗舰版</span>\n                <span class=\"plan-price\">¥35 / 月</span>\n                <span class=\"plan-year\">年付 ¥350 / 年</span>\n              </th>\n              <th>\n                <span class=\"plan-name\">团队版</span>\n                <span class=\"plan-price\">¥85 / 月</span>\n                <span class=\"plan-year\">年付 ¥850 / 年</span>\n              </th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>每月流量</th>\n              <td>100GB</td>\n              <td class=\"featured\">300GB</td>\n              <td>1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td class=\"featured\">5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>流媒体解锁</th>\n              <td>基础流媒体</td>\n              <td class=\"featured\">全节点原生流媒体解锁</td>\n              <td>全节点原生流媒体解锁</td>\n            </tr>\n            <tr>\n              <th>线路类型</th>\n              <td>普通线路节点池</td>\n              <td class=\"featured\">IPLC 专线，游戏方向优化</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>支持方式</th>\n              <td>标准工单</td>\n              <td class=\"featured\">7×24 优先工单</td>\n              <td>专属客户经理</td>\n            </tr>\n            <tr>\n              <th>企业定制</th>\n              <td>不含</td>\n              <td class=\"featured\">不含</td>\n              <td>支持企业定制路由</td>\n            </tr>\n            <tr>\n              <th>适合谁</th>\n              <td>个人轻度使用</td>\n              <td class=\"featured\">个人主力使用，兼顾娱乐与游戏</td>\n              <td>多人或多设备协同的团队</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n      <p class=\"table-note\">说明：表中价格与权益为本页发布时的展示内容，未包含可能存在的税费或其他附加项。年付价按一次性支付一年的方式计算，折算下来低于十二个月月付合计。流量按自然月重置，未用完不结转。</p>\n    </div>\n  </section>\n\n  <section class=\"block\" id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-tag\">03 客户端</span>\n        <h2 class=\"sec-title\">用什么设备接入，也要先想清楚</h2>\n      </div>\n      <p class=\"sec-intro\">YY 的订阅按同时在线的终端数量计算，因此客户端选择和档位选择是同一件事的两面。下面按使用场景列出三类入口。</p>\n\n      <div class=\"clients\">\n        <article class=\"client\">\n          <span class=\"big\">A</span>\n          <h3>桌面客户端</h3>\n          <p class=\"tagline\">适合长期开着的电脑</p>\n          <p>在笔记本或台式机上安装桌面端，配置一次后随系统启动即可。占用一个设备名额，适合当作主要接入方式。</p>\n        </article>\n        <article class=\"client\">\n          <span class=\"big\">B</span>\n          <h3>移动客户端</h3>\n          <p class=\"tagline\">适合手机与平板</p>\n          <p>手机和平板各装一份，走到哪用到哪。注意每台终端单独计数，旗舰版的 5 台对多数人来说够用，团队版则留给多人各自持有设备的情况。</p>\n        </article>\n        <article class=\"client\">\n          <span class=\"big\">C</span>\n          <h3>路由器与共享场景</h3>\n          <p class=\"tagline\">适合一屋子设备</p>\n          <p>若希望整网设备共用一条线路，需要在路由器侧完成配置。这类用法对设备名额的占用方式与单机安装不同，建议先对照团队版再决定。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"block\" id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-tag\">04 常见问题</span>\n        <h2 class=\"sec-title\">你可能正在想的八个问题</h2>\n      </div>\n      <p class=\"sec-intro\">下面这些问题按“先问选哪个、再问怎么算、最后问怎么改”的顺序排列，每一条都给出一句能直接用的回答。</p>\n\n      <div class=\"faq-grid\">\n        <article class=\"faq\">\n          <h3>我应该直接选推荐档吗？</h3>\n          <p>不一定。推荐标记只是说明旗舰版在大多数个人使用场景下覆盖更全。如果你的用量确实低于 100GB、设备不超过 3 台，基础版就够了，多付的钱不会让低用量变快。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>流量是怎么计算的？</h3>\n          <p>按自然月统计，每月重置，未用完的部分不结转到下个月。三个档位分别对应 100GB、300GB 和 1000GB，统计口径以客户端内显示为准。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>设备台数怎么算一台？</h3>\n          <p>按同时在线的终端计数。手机、平板、电脑各算一台。如果你在同一台设备上切换不同客户端，通常仍然算一台，但具体以客户端判断方式为准。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>年付真的比月付划算吗？</h3>\n          <p>按页面展示的价格，三个档位的年付金额都低于月付乘以十二。基础版 ¥150 对比 ¥180，旗舰版 ¥350 对比 ¥420，团队版 ¥850 对比 ¥1020。是否选择年付，取决于你确定要用多久。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>三档之间可以中途更换吗？</h3>\n          <p>可以先按最小可行的一档开通，用一个月观察实际消耗，再决定是否升档。关于变更的具体规则与生效时间，以你开通时确认的条款为准，本页不做额外承诺。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>团队版的企业定制路由指什么？</h3>\n          <p>指针对团队网络结构单独配置路由规则的能力，适合多人共用、需要按部门或按设备分别管理的场景。具体能做到什么程度，需要根据你的网络环境单独沟通。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>流媒体解锁在三个档位上差在哪？</h3>\n          <p>基础版只覆盖基础流媒体场景；旗舰版与团队版提供全节点原生流媒体解锁。如果你主要用途是看片，基础版可能遇到部分场景不可用的情况，这一点值得在下单前确认。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>遇到问题先找谁？</h3>\n          <p>基础版走标准工单，旗舰版是 7×24 优先工单，团队版由专属客户经理对接。先确认你当前所在档位对应的支持方式，再按对应渠道提交，能少绕一圈。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"closing\">\n    <div class=\"wrap\">\n      <h2>看完还拿不定主意，就从最小的一档开始</h2>\n      <p class=\"note\">先用一个月把真实用量测出来，比在三个档位之间反复比较更有效。YY 的档位是按用量与设备数分层的，数字对上，选择自然就清楚了。</p>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <span>YY · 订阅与使用说明</span>\n    <span>价格与权益以本页表格为准 · <a href=\"#plans\">回到方案对比</a></span>\n  </div>\n</footer>",
